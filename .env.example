# Supabase bağlantısı. Canlı projeyi değil, geliştirme/test projesini veya yerel Supabase'i yazın.
# (publishable/anon anahtar tarayıcıya açıktır; güvenlik RLS ile sağlanır. Canlı değerler yalnız Render ortam değişkenlerinde durur.)
VITE_SUPABASE_URL=https://<gelistirme-projesi>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<gelistirme-anahtari>
# Render için: VITE_ROUTER=hash  ·  Tıklanabilir tanıtım derlemesi: VITE_DEMO=1
